<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.gha</TargetExt>
    <AssemblyName>ADDGH</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RestoreSources>$(MSBuildThisFileDirectory)..\nuget-offline</RestoreSources>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="7.0.20314.3001" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core" Condition="Exists('C:\\Program Files (x86)\\ASUS\\ASUS Member Center\\Microsoft.Web.WebView2.Core.dll')">
      <HintPath>C:\\Program Files (x86)\\ASUS\\ASUS Member Center\\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf" Condition="Exists('C:\\Program Files (x86)\\ASUS\\ASUS Member Center\\Microsoft.Web.WebView2.Wpf.dll')">
      <HintPath>C:\\Program Files (x86)\\ASUS\\ASUS Member Center\\Microsoft.Web.WebView2.Wpf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj_verify\**\*.cs" />
    <EmbeddedResource Remove="obj_verify\**\*" />
    <None Remove="obj_verify\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CanvasWeb\dist\**\*" Condition="Exists('..\CanvasWeb\dist')">
      <Link>CanvasWeb\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyGhaAsDllForConsumers" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
